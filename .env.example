# Cible du proxy Vite pour les appels API.
# Le back n'est pas encore fixé : ajuster selon son mode de lancement.
#
#   Back-end dans le même podman-compose  → http://backend:5000
#   Back-end lancé sur l'hôte             → http://host.containers.internal:5000
#
VITE_API_TARGET=http://localhost:5000